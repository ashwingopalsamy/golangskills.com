{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golangskills.com/schemas/claims-v2.json",
  "title": "golangskills.com claim ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verified_on", "claims"],
  "properties": {
    "schema_version": { "const": 2 },
    "verified_on": { "type": "string", "format": "date" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "status", "scope", "invariant", "qualifications", "counterexamples", "go_versions", "owners", "risk_domains", "primary_evidence", "observed_in"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "statement": { "type": "string", "minLength": 1 },
          "status": { "enum": ["adopted", "adopted-with-qualifications", "organizational-preference", "version-specific", "rejected", "outside-project-scope"] },
          "scope": { "type": "string", "minLength": 1 },
          "invariant": { "type": "string", "minLength": 1 },
          "qualifications": { "type": "array", "items": { "type": "string" } },
          "counterexamples": { "type": "array", "items": { "type": "string" } },
          "go_versions": { "type": "array", "items": { "type": "string", "pattern": "^1\\.[0-9]+$" } },
          "owners": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "risk_domains": { "type": "array", "items": { "type": "string" } },
          "primary_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "url", "publisher", "kind", "verified_on"],
              "properties": {
                "title": { "type": "string" },
                "url": { "type": "string", "format": "uri" },
                "publisher": { "type": "string" },
                "kind": { "enum": ["normative", "primary", "protocol", "operational", "regulatory"] },
                "verified_on": { "type": "string", "format": "date" }
              }
            }
          },
          "observed_in": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
