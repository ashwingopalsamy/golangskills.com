{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golangskills.com/schemas/evals-v2.schema.json",
  "title": "golangskills.com skill evaluations v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill", "cases"],
  "properties": {
    "schema_version": { "const": 2 },
    "skill": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "split", "prompt"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["routing", "quality"] },
          "split": { "enum": ["development", "holdout"] },
          "prompt": { "type": "string", "minLength": 1 },
          "should_activate": { "type": "boolean" },
          "reason": { "type": "string" },
          "confuses_with": { "type": "array", "items": { "type": "string" } },
          "fixture": { "type": "string" },
          "expected_invariants": { "type": "array", "items": { "type": "string" } },
          "forbidden_outcomes": { "type": "array", "items": { "type": "string" } },
          "graders": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "weight"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                "kind": { "enum": ["contains", "not-contains", "go-test", "json"] },
                "target": { "enum": ["./...", "-race ./..."] },
                "oracle": { "type": "string", "pattern": "^evaluations/oracles/.+_test\\.go$" },
                "required": { "type": "array", "items": { "type": "string" } },
                "forbidden": { "type": "array", "items": { "type": "string" } },
                "weight": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          },
          "semantic_rubric": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
