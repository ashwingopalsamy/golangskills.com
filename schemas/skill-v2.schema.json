{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golangskills.com/schemas/skill-v2.schema.json",
  "title": "golangskills.com skill metadata v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "collection", "display_name", "short_description", "default_prompt", "version", "maturity", "category", "risk_domains", "tags", "go_versions", "claim_ids", "relations", "compatibility_evidence", "source_provenance", "sources"],
  "properties": {
    "schema_version": { "const": 2 },
    "collection": { "enum": ["engineering-skills-for-go", "distributed-systems-skills-for-go", "fintech-skills-for-go"] },
    "display_name": { "type": "string", "minLength": 3, "maxLength": 64 },
    "short_description": { "type": "string", "minLength": 20, "maxLength": 64 },
    "default_prompt": { "type": "string", "minLength": 1, "maxLength": 200 },
    "version": { "type": "string" },
    "maturity": { "enum": ["experimental", "beta", "stable"] },
    "category": { "type": "string" },
    "risk_domains": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "tags": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string" } },
    "go_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "guidance"],
      "properties": {
        "minimum": { "const": "1.24" },
        "guidance": { "type": "array", "contains": { "const": "1.25" }, "minContains": 1 },
        "legacy": { "type": "array", "items": { "type": "string" } }
      }
    },
    "claim_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "relations": { "type": "object" },
    "compatibility_evidence": { "type": "array", "minItems": 4, "maxItems": 4 },
    "source_provenance": { "type": "object" },
    "sources": { "type": "array", "minItems": 2 }
  }
}
