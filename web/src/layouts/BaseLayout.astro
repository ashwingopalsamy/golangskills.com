---
const {
  title,
  description,
  canonicalPath,
  markdownPath,
  imagePath = "/assets/engineering-logo.png",
  imageAlt = "Go Engineering Skills",
  basePath = "./",
  jsonLd,
} = Astro.props;
const canonical = `https://golangskills.com${canonicalPath}`;
const image = `https://golangskills.com${imagePath}`;
const safeJsonLd = jsonLd ? JSON.stringify(jsonLd).replace(/</g, "\\u003c") : "";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#fdfdfd" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#070707" media="(prefers-color-scheme: dark)">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1">
    <link rel="canonical" href={canonical}>
    {markdownPath && <link rel="alternate" type="text/markdown" title="Markdown version" href={`https://golangskills.com${markdownPath}`} />}
    <link rel="icon" type="image/png" href={`${basePath}assets/engineering-logo.png`}>
    <link rel="stylesheet" href={`${basePath}assets/site.css`}>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Go Engineering Skills">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={image}>
    <meta property="og:image:alt" content={imageAlt}>
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={image}>
    {safeJsonLd && <script type="application/ld+json" set:html={safeJsonLd}></script>}
    <script src={`${basePath}assets/site.js`} defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-nav">
      <div class="site-nav-inner page-width">
        <div class="site-nav-left">
          <a class="brand" href={`${basePath}index.html`} aria-label="Go Engineering Skills home">
            <img src={`${basePath}assets/engineering-logo.png`} width="24" height="24" alt="">
            <span class="brand-word"><strong>Go skills</strong><span class="brand-word-dim">.com</span></span>
          </a>
          <nav class="site-nav-menu" aria-label="Main navigation">
            <a class="nav-pill" href={`${basePath}index.html#catalog`}>Catalog</a>
            <a class="nav-pill" href={`${basePath}skill.html`}>Install guide</a>
            <a class="nav-pill nav-agent-link" href={`${basePath}llms.txt`}>For agents</a>
          </nav>
        </div>
        <div class="site-nav-right">
          <a class="utility-pill search-trigger" href={`${basePath}index.html#catalog`} aria-label="Search the skill catalog, Command or Control K">
            <span aria-hidden="true">⌕</span><span class="utility-label">Find a skill</span><kbd>⌘ K</kbd>
          </a>
          <button class="utility-pill theme-toggle enhanced-only" type="button" hidden aria-label="Switch to dark theme" aria-pressed="false">
            <span class="theme-glyph" aria-hidden="true">◐</span><span class="utility-label theme-label">Theme</span>
          </button>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <p class="visually-hidden" data-copy-status role="status" aria-live="polite"></p>
    <footer class="site-footer page-width">
      <a class="brand footer-brand" href={`${basePath}index.html`} aria-label="Go Engineering Skills home">
        <img src={`${basePath}assets/engineering-logo.png`} width="24" height="24" alt="">
        <span class="brand-word"><strong>Go skills</strong><span class="brand-word-dim">.com</span></span>
      </a>
      <nav class="footer-links" aria-label="Project resources">
        <a href={`${basePath}skill.html`}>Install guide</a>
        <a href={`${basePath}sitemap.md`}>Sitemap</a>
        <a href={`${basePath}llms.txt`}>LLM context</a>
        <a href={`${basePath}.well-known/agents.md`}>Agent guide</a>
        <a href="https://github.com/ashwingopalsamy/golangskills.com">GitHub source</a>
        <a href="https://github.com/ashwingopalsamy/golangskills.com/blob/main/LICENSE">Apache-2.0</a>
      </nav>
      <p class="footer-note">Independent project. Not endorsed by Google or the Go project.</p>
    </footer>
  </body>
</html>
